<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.bijoux.erp</groupId>
        <artifactId>erp-bijoux-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>api-public</artifactId>
    <name>ERP Bijoux :: Public API Application</name>
    <description>Application Spring Boot exécutable - Point d'entrée REST API, Security &amp; Spring Modulith</description>

    <dependencies>
        <!-- Modules Internes ERP -->
        <dependency>
            <groupId>fr.bijoux.erp</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bijoux.erp</groupId>
            <artifactId>catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bijoux.erp</groupId>
            <artifactId>pos</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bijoux.erp</groupId>
            <artifactId>police-book</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bijoux.erp</groupId>
            <artifactId>gold</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bijoux.erp</groupId>
            <artifactId>workshop</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bijoux.erp</groupId>
            <artifactId>weight-account</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.bijoux.erp</groupId>
            <artifactId>crm</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Modulith -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Base de données & Migrations -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
